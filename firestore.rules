rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Minimum available balance ────────────────────────────────────────────
    // Reads the caller's own users/{uid}.balance as it is BEFORE the write, so it
    // works inside batches that also deduct the stake. Anyone below $10 cannot open
    // a bet or trade or start following a copy expert/trader, even if they have
    // deposited in the past.
    function currentBalance() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('balance', 0);
    }
    function hasMinBalance() { return currentBalance() >= 10; }

    // ── Emergency switch ─────────────────────────────────────────────────────
    // true  = every balance change must be backed by a settled position or a closed trade,
    //         and each settlement / trade close must move the balance by exactly its amount.
    // false = turns those money-consistency checks off (all other rules stay on). Flip it and
    //         publish if a flow ever breaks after a rules update.
    function strictMoney() { return true; }

    // Balance of the signed-in user before / after the write (works inside batches and
    // transactions that also touch the users doc).
    function balanceBefore() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('balance', 0);
    }
    function balanceAfter() {
      return getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('balance', 0);
    }

    // ── KYC ──────────────────────────────────────────────────────────────────
    // A user can only ever submit 'pending'. 'verified' is allowed from a user only while
    // the admin's settings/kyc.autoVerify switch is on; otherwise only an admin can verify.
    function autoVerifyOn() {
      return get(/databases/$(database)/documents/settings/kyc).data.get('autoVerify', false) == true;
    }
    function kycStatusOk(s) { return s == 'pending' || (s == 'verified' && autoVerifyOn()); }

    // ── Settlement ───────────────────────────────────────────────────────────
    // A position may only be settled by its owner: open -> won/lost, touching only the
    // settlement fields, not before its own close date (resolveAt), and consistently:
    //   won  -> the position's side matches the market's secret outcome, the payout does not
    //           exceed stake / entryProbability less the 2% fee, and the balance rises by
    //           exactly the payout in the same write
    //   lost -> payout is 0 and the balance is unchanged
    function isSettlement() {
      return resource.data.status == 'open'
        && request.resource.data.status in ['won', 'lost']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'payoutAmount', 'feeAmount', 'settledAt'])
        && (resource.data.get('resolveAt', null) == null
            || request.time >= resource.data.resolveAt)
        && settlementOutcomeOk();
    }
    function marketBias() {
      return get(/databases/$(database)/documents/marketSecrets/$(resource.data.marketId))
               .data.get('resolutionBias', null);
    }
    // Whole check sits behind strictMoney(), so the emergency switch also restores settlement.
    function settlementOutcomeOk() {
      let p = resource.data.get('entryProbability', 50);
      return !strictMoney()
          || (request.resource.data.status == 'won'
              && resource.data.side == marketBias()
              && request.resource.data.payoutAmount is number
              && request.resource.data.payoutAmount * p <= resource.data.stake * 98 + 0.02 * p
              && math.abs((balanceAfter() - balanceBefore()) - request.resource.data.payoutAmount) < 0.01)
          || (request.resource.data.status == 'lost'
              && request.resource.data.payoutAmount == 0
              && balanceAfter() == balanceBefore());
    }

    // ── Where a balance INCREASE may come from ───────────────────────────────
    // The write must carry lastCredit = { col, id } naming a position that this same write
    // settles as 'won' (credit == payout), or a trade it closes (credit == profitLoss).
    function creditFromPosition(col, id, delta) {
      let p = /databases/$(database)/documents/$(col)/$(id);
      return get(p).data.userId == request.auth.uid
          && get(p).data.status == 'open'
          && getAfter(p).data.status == 'won'
          && math.abs(getAfter(p).data.payoutAmount - delta) < 0.01;
    }
    function creditFromTrade(id, delta) {
      let p = /databases/$(database)/documents/trades/$(id);
      return get(p).data.userId == request.auth.uid
          && get(p).data.status == 'open'
          && getAfter(p).data.status == 'closed'
          && math.abs(getAfter(p).data.profitLoss - delta) < 0.01;
    }
    function creditJustified(delta) {
      let ref = request.resource.data.get('lastCredit', null);
      return ref != null
          && ref.keys().hasOnly(['col', 'id'])
          && ((ref.col in ['positions', 'copyPositions'] && creditFromPosition(ref.col, ref.id, delta))
              || (ref.col == 'trades' && creditFromTrade(ref.id, delta)));
    }
    // Decreases are always fine (bets, losses, stop-out). Setting the balance to 0 or below is
    // fine too. Anything that raises it must be justified as above.
    function balanceChangeOk() {
      let b0 = resource.data.get('balance', 0);
      let b1 = request.resource.data.get('balance', 0);
      return b1 <= b0 || b1 <= 0 || !strictMoney() || creditJustified(b1 - b0);
    }
    // What an owner may change on their own users doc: not the account id, creation date, email
    // or the admin-set copy-trading limits; kycStatus only per kycStatusOk; balance per above.
    function ownerUserUpdateOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['accountId', 'createdAt', 'email', 'copyRisk', 'copyRR', 'copyMaxTrades'])
          && (!changed.hasAny(['kycStatus']) || kycStatusOk(request.resource.data.kycStatus))
          && (!changed.hasAny(['balance']) || balanceChangeOk());
    }

    // A trade may only be closed by its owner: open -> closed, touching only the close fields,
    // with the balance moving by exactly the trade's P&L in the same write. A stop-out must
    // take the balance to 0.
    function ownerTradeClose() {
      return resource.data.status == 'open'
        && request.resource.data.status == 'closed'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'exitPrice', 'profitLoss', 'closedAt', 'closedBy'])
        && request.resource.data.profitLoss is number
        && (!strictMoney()
            || (request.resource.data.closedBy == 'stopout'
                  ? balanceAfter() == 0
                  : math.abs((balanceAfter() - balanceBefore()) - request.resource.data.profitLoss) < 0.01));
    }

    // ── Admins ───────────────────────────────────────────────────────────────
    match /admins/{uid} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // CRITICAL: create must be allowed for any signed-in user writing their OWN
    // doc. Firebase Auth creates the user first, then the client writes the doc.
    // The user IS signed in at that point (auth.currentUser exists), so isOwner
    // works correctly. No cross-collection queries are needed because account IDs
    // are generated locally.
    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      // New accounts start at 0 and can't self-verify or set admin-only limits.
      allow create: if isOwner(uid) &&
                       request.resource.data.get('balance', 0) == 0 &&
                       request.resource.data.get('kycStatus', '') != 'verified' &&
                       !request.resource.data.keys().hasAny(['copyRisk', 'copyRR', 'copyMaxTrades', 'lastCredit']);
      allow update: if isAdmin() || (isOwner(uid) && ownerUserUpdateOk());
      allow delete: if isAdmin();
    }

    // ── Markets ───────────────────────────────────────────────────────────────
    match /markets/{marketId} {
      allow read:   if true;
      allow create: if isAdmin();
      // Signed-in users may only bump the volume counter when they bet.
      allow update: if isAdmin() ||
                       (isSignedIn() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVolume']));
      allow delete: if isAdmin();
    }

    // ── Market live state ─────────────────────────────────────────────────────
    match /marketLive/{marketId} {
      allow read:   if true;
      allow create: if isAdmin() ||
                       (isSignedIn() &&
                        request.resource.data.keys().hasOnly(['totalVolume', 'lastUpdated']));
      allow update: if isAdmin() ||
                       (isSignedIn() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVolume', 'lastUpdated']));
      allow delete: if isAdmin();
    }

    // ── Trading — live price caches (Forex/Commodities) ─────────────────────
    // Single docs: forexPrices/latest, commodityPrices/latest.
    // One client fetches from the external API and writes; everyone else reads.
    // Same shared-cache pattern as marketLive above.
    match /forexPrices/{doc} {
      allow read:  if true;
      allow write: if isSignedIn();
    }
    match /commodityPrices/{doc} {
      allow read:  if true;
      allow write: if isSignedIn();
    }

    // ── Market secrets ────────────────────────────────────────────────────────
    match /marketSecrets/{marketId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Positions ─────────────────────────────────────────────────────────────
    match /positions/{posId} {
      allow read:   if isSignedIn() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'open' &&
                       hasMinBalance() &&
                       request.resource.data.stake is number &&
                       request.resource.data.stake <= currentBalance();
      allow update: if isAdmin() ||
                       (isSignedIn() && resource.data.userId == request.auth.uid && isSettlement());
      allow delete: if isAdmin();
    }

    // ── Copy positions ────────────────────────────────────────────────────────
    match /copyPositions/{posId} {
      allow read:   if isSignedIn() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'open' &&
                       hasMinBalance() &&
                       request.resource.data.stake is number &&
                       request.resource.data.stake <= currentBalance();
      allow update: if isAdmin() ||
                       (isSignedIn() && resource.data.userId == request.auth.uid && isSettlement());
      allow delete: if isAdmin();
    }

    // ── Trades (Forex/Commodities/Crypto) ───────────────────────────────────
    // Same ownership pattern as positions — draws from and returns to the
    // single shared users/{uid}.balance field, not a separate trading balance.
    match /trades/{tradeId} {
      allow read:   if isSignedIn() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'open' &&
                       hasMinBalance();
      allow update: if isAdmin() ||
                       (isSignedIn() && resource.data.userId == request.auth.uid && ownerTradeClose());
      allow delete: if isAdmin();
    }

    // ── Copy betting state ────────────────────────────────────────────────────
    match /copyBetting/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      // Starting to follow (status -> 'active') needs the minimum balance.
      // Counter updates on an already-active follow, and stopping, stay allowed.
      // riskPercent / maxBetsPerDay are not user-settable.
      allow create: if isOwner(uid) &&
                       (request.resource.data.get('status', '') != 'active' || hasMinBalance()) &&
                       !request.resource.data.keys().hasAny(['riskPercent', 'maxBetsPerDay']);
      allow update: if isAdmin() ||
                       (isOwner(uid) &&
                        (request.resource.data.get('status', '') != 'active' ||
                         resource.data.get('status', '') == 'active' ||
                         hasMinBalance()) &&
                        !request.resource.data.diff(resource.data).affectedKeys()
                           .hasAny(['riskPercent', 'maxBetsPerDay']));
      allow delete: if isAdmin();
    }

    // ── Copy trading state (Forex/Commodity expert traders) ─────────────────
    // Same shape as copyBetting above — a single doc per user, which is what
    // structurally enforces "only one active follow across both sections":
    // the unified copytrade.html checks both docs before allowing a new follow.
    match /copyTrading/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      // Starting to follow (status -> 'active') needs the minimum balance.
      // Counter updates on an already-active follow, and stopping, stay allowed.
      // baseBalance (what risk is sized from) can never be set above the real balance.
      allow create: if isOwner(uid) &&
                       (request.resource.data.get('status', '') != 'active' || hasMinBalance()) &&
                       request.resource.data.get('baseBalance', 0) <= currentBalance();
      allow update: if isAdmin() ||
                       (isOwner(uid) &&
                        (request.resource.data.get('status', '') != 'active' ||
                         resource.data.get('status', '') == 'active' ||
                         hasMinBalance()) &&
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['baseBalance']) ||
                         request.resource.data.baseBalance <= currentBalance()));
      allow delete: if isAdmin();
    }

    // ── Transactions ──────────────────────────────────────────────────────────
    match /transactions/{txId} {
      allow read:   if isSignedIn() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Wallets ───────────────────────────────────────────────────────────────
    // Single doc: wallets/addresses — public read so deposit page can show addresses
    match /wallets/{doc} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Settings ─────────────────────────────────────────────────────────────
    match /settings/{doc} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Support chat ──────────────────────────────────────────────────────────
    // chatId is always the participant's auth uid — real for signed-in users,
    // anonymous for guests (via signInAnonymously). This gives every user or
    // guest exactly one conversation thread, readable/writable by themselves
    // or an admin, with no cross-user access possible.
    match /chats/{chatId} {
      allow read:   if isSignedIn() && (request.auth.uid == chatId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == chatId;
      allow update: if isSignedIn() && (request.auth.uid == chatId || isAdmin());
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read:   if isSignedIn() && (request.auth.uid == chatId || isAdmin());
        allow create: if isSignedIn() && (request.auth.uid == chatId || isAdmin());
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ── KYC ──────────────────────────────────────────────────────────────────
    match /kyc/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && kycStatusOk(request.resource.data.get('status', ''));
      allow update: if isAdmin() ||
                       (isOwner(uid) && kycStatusOk(request.resource.data.get('status', '')));
      allow delete: if isAdmin();
    }
  }
}
